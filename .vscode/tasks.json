{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start PathSnap API (FastAPI)",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/bin/uvicorn api.main:app --host 0.0.0.0 --port 8000",
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Start PathSnap UI (HTTP 8080)",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/bin/python -m http.server 8080 --directory ui",
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Start Both (API + UI)",
      "dependsOn": [
        "Start PathSnap API (FastAPI)",
        "Start PathSnap UI (HTTP 8080)"
      ],
      "problemMatcher": []
    }
  ]
}
